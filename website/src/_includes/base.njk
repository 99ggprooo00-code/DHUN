{#- Base layout: the app's shell. Head, skip link, glass app bar, navigation
    (bottom tabs on phones, rail above 840px), the docked bar that leads into
    the live app, and the footer that carries the appearance controls.

    One <h1> per page comes from the page template, never from here. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{#- The app is dark-first (DhunThemeMode.default = DARK) and offers light; the
    bar's own colour follows the scheme in use. Kept in step with the tokens by
    `design_system_violations` in scripts/website_quality.py. -#}
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F6F4F1" media="(prefers-color-scheme: light)">
<meta name="generator" content="Eleventy">
<meta property="og:type" content="{{ site.ogType }}">
<meta property="og:site_name" content="DHUN">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ description }}">
{#- The icon is inlined as a `data:` URI (src/_data/favicon.js), so a route
    makes exactly one request: this document. A rule decodes it back out of the
    built page and compares it with src/assets/dhun-favicon.svg. -#}
{#- Structured data: what the software is, in the one shape a machine reads.
    No `aggregateRating`, no `offers`, no `softwareVersion`, no download URL:
    nothing here that the repository cannot support (no stable release exists,
    so there is no version to name) and nothing that points at a build — the
    site is not a distribution channel. `structured_data_violations` in
    scripts/website_quality.py asserts every one of those omissions, so this
    comment cannot drift from the JSON below it. -#}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"SoftwareApplication","name":"DHUN","applicationCategory":"MultimediaApplication","operatingSystem":"Android 7.0+, Windows, experimental browser client","description":"{{ site.description }}","isAccessibleForFree":true,"license":"{{ site.licence }}","url":"{{ site.url }}/","codeRepository":"{{ site.repo }}"}
</script>
<link rel="icon" href="{{ favicon.dataUri }}" type="image/svg+xml">
{#- One request per route: the stylesheet the page needs is inlined here from
    the modules its front matter declares (see eleventy.config.js). -#}
<style>{{ cssModules | inlineCss | safe }}</style>
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
</head>
<body>
{#- Icon geometry, once per page: every {% icon %} below is a <use> reference.
    The transform in eleventy.config.js fills this slot from the document itself. -#}
<!--icon-sprite-->
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap app-bar">
    {#- aria-current marks the destination the visitor is on. `/` is the wordmark,
        which is the site's home link; the nav items mark themselves when their
        href is this page's URL. Exactly one per page, asserted by
        `navigation_state_violations` in scripts/website_quality.py and measured,
        including in Windows High Contrast, in website/tests/browser.mjs. -#}
    <a class="wordmark" href="{{ '/' | sitePath }}" aria-label="DHUN home"{% if page.url == "/" %} aria-current="page"{% endif %}>
      <span class="wordmark-mark" aria-hidden="true">{% icon "play" %}</span>
      <span>DHUN</span>
    </a>
    <p class="app-bar__title">{{ appBarTitle or "Music without an account" }}</p>
    <div class="app-bar__actions">
      <a class="icon-btn" href="{{ site.repo }}" rel="noopener" aria-label="Source on GitHub">{% icon "external" %}</a>
      <a class="btn btn--primary" href="{{ '/app/' | sitePath }}">Open the app</a>
    </div>
  </div>
</header>
{#- The app's navigation: DhunBottomNavigation on a phone, DhunNavigationRail
    from 840px up (`website/css/shell.css`). One element, so there is exactly one
    `aria-current` and one set of tab stops. -#}
<nav class="site-nav" aria-label="Main">
  <ul>
    {%- for item in site.nav %}
    <li><a href="{{ item.href | sitePath }}"{% if item.external %} rel="noopener"{% endif %}{% if item.href == page.url %} aria-current="page"{% endif %}>{% icon item.icon %}<span>{{ item.label }}</span>{% if item.external %}<span class="sr-only"> (opens in a new tab)</span>{% endif %}</a></li>
    {%- endfor %}
  </ul>
</nav>
{#- The docked bar, where the app keeps its mini-player: the one destination
    this site exists to hand a visitor. It sits in a landmark of its own, because
    axe's `region` rule requires every node to be inside one — a link loose in
    the body was its one finding per page (browser job, 2026-10-16). -#}
<aside class="dock-landmark" aria-label="The DHUN web app">
<a class="dock" href="{{ '/app/' | sitePath }}">
  <span class="dock__art" aria-hidden="true">{% icon "play" %}</span>
  <span class="dock__text">
    <span class="dock__title">Try the live app</span>
    <span class="dock__sub">{{ dockNote or "Runs in this browser — no sign-in, no install" }}</span>
  </span>
  <span class="dock__go" aria-hidden="true">{% icon "skipNext" %}</span>
</a>
</aside>
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">DHUN</p>
        <p class="footer-note">{{ site.footer.licence }}
        <a href="{{ site.licence }}" rel="noopener">LICENSE</a> ·
        <a href="{{ site.thirdParty }}" rel="noopener">THIRD_PARTY.md</a></p>
      </div>
      <nav aria-label="Footer">
        <ul class="footer-links">
          <li><a href="{{ '/features/' | sitePath }}">Features</a></li>
          <li><a href="{{ '/ui/' | sitePath }}">Interface</a></li>
          <li><a href="{{ site.repo }}" rel="noopener">Source</a></li>
          <li><a href="{{ site.issues }}" rel="noopener">Report an issue</a></li>
          <li><a href="{{ site.changelog }}" rel="noopener">Changelog</a></li>
          <li><a href="{{ site.publicReleasePage }}" rel="noopener">Public pre-release</a></li>
          <li><a href="{{ site.nativeTerms }}" rel="noopener">Native Terms draft</a></li>
          <li><a href="{{ site.nativePrivacy }}" rel="noopener">Native Privacy draft</a></li>
          <li><a href="{{ '/app/#/about/terms' | sitePath }}">Browser Terms draft</a></li>
          <li><a href="{{ '/app/#/about/privacy' | sitePath }}">Browser Privacy draft</a></li>
        </ul>
      </nav>
    </div>
    <!-- docs/PRD.md §1; docs/research/05-source-capability-matrix.md; ADR-010 amendment 2026-10-28 -->
    <p class="footer-note" data-product-direction>{{ site.providerSummary }}</p>
    <p class="footer-note"><a href="{{ site.productDirection }}" rel="noopener">Product direction</a> ·
      <a href="{{ site.providerMatrix }}" rel="noopener">Provider status and evidence</a></p>
    <p class="footer-note footer-independence">{{ site.footer.independence }}</p>
    <p class="footer-note">{{ site.footer.builtWith }}</p>

    {#- The app's appearance settings, as the app's Settings screen offers them:
        a theme (dark by default) and one of six accent ramps. Radio inputs +
        `:has()` in css/tokens.css do the work — the site ships no JavaScript at
        all, so this is the whole mechanism. -#}
    <section class="appearance" aria-labelledby="appearance-title">
      <h2 class="appearance__title" id="appearance-title">Appearance</h2>
      <!--{{ site.appearanceSource }}-->
      <p class="appearance__lead">
        The same two choices the app's Settings screen offers, applied to this page with
        CSS only: dark by default, light on request, and the six accent ramps the app
        ships. Nothing is stored and nothing is sent — reload the page and it is back to
        your system's preference.
      </p>
      <div class="appearance__groups">
        <fieldset class="appearance__group">
          <legend>Theme</legend>
          <div class="appearance__choices">
            <label class="appearance__choice">
              <input type="radio" name="dhun-theme" value="system" checked>
              <span>Match system</span>
            </label>
            <label class="appearance__choice">
              <input type="radio" name="dhun-theme" value="dark" id="theme-dark">
              <span>Dark</span>
            </label>
            <label class="appearance__choice">
              <input type="radio" name="dhun-theme" value="light" id="theme-light">
              <span>Light</span>
            </label>
          </div>
        </fieldset>
        <fieldset class="appearance__group">
          <legend>Accent</legend>
          <div class="appearance__choices">
            {%- for ramp in site.accents %}
            <label class="appearance__choice">
              <input type="radio" name="dhun-accent" value="{{ ramp.id }}" id="accent-{{ ramp.id }}"{% if ramp.default %} checked{% endif %}>
              <span class="appearance__chip appearance__chip--{{ ramp.id }}" aria-hidden="true"></span>
              <span>{{ ramp.label }}</span>
            </label>
            {%- endfor %}
          </div>
        </fieldset>
      </div>
    </section>
  </div>
</footer>
</body>
</html>
