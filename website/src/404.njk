---
layout: base.njk
title: "Page not found — DHUN"
permalink: /404.html
description: "That page does not exist on this site. DHUN has three pages: home, features, and the interface."
cssModules: ["tokens", "base", "components"]
# A 404 is not one of the site's three destinations: it carries `noindex` so a
# crawler that reaches it through a soft-404 path does not list it (it is also
# absent from sitemap.xml — `crawlability_violations` asserts both directions).
extraHead: '<meta name="robots" content="noindex">'
---
<div class="wrap">
  <section class="error-page" aria-labelledby="nf-title">
    <!-- src/sitemap.njk lists the site's three routes; anything else is a 404 by design. -->
    <p class="error-code">404</p>
    <h1 id="nf-title">That page is not here.</h1>
    <p class="lede">This site has three pages, and one of them is probably the one you wanted.</p>
    <div class="cta-row" style="justify-content: center;">
      <a class="btn btn--primary" href="{{ '/ui/' | sitePath }}">See the interface</a>
      <a class="btn btn--secondary" href="{{ '/features/' | sitePath }}">Features</a>
      <a class="btn btn--secondary" href="{{ '/' | sitePath }}">Home</a>
    </div>
    <p class="traceable">Looking for the source, the roadmap or the known limitations?
      They live in the repository: <a href="{{ site.repo }}" rel="noopener">{{ site.repo }}</a>.</p>
  </section>
</div>
