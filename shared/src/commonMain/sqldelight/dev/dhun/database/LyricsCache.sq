CREATE TABLE LyricsCache (
    trackId TEXT NOT NULL PRIMARY KEY,
    isSynced INTEGER AS kotlin.Boolean NOT NULL,
    content TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    provider TEXT
);

insert:
INSERT OR REPLACE INTO LyricsCache(trackId, isSynced, content, cachedAt, provider) VALUES (?, ?, ?, ?, ?);

selectByTrackId:
SELECT * FROM LyricsCache WHERE trackId = ?;

deleteByTrackId:
DELETE FROM LyricsCache WHERE trackId = ?;

clear:
DELETE FROM LyricsCache;

selectAll:
SELECT * FROM LyricsCache;
