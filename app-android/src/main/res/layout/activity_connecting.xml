<?xml version="1.0" encoding="utf-8"?>
<!-- First-frame launch UI. Views only — no Compose. Shown until the
     playback engine is Ready, so an API < 31 Compose GraphicsLayer
     crash cannot make the app look like it never opened. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ic_launcher_background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/connecting_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/connecting_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFBB86FC" />

        <TextView
            android:id="@+id/connecting_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/launch_connecting_status"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/connecting_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp" />
</FrameLayout>
