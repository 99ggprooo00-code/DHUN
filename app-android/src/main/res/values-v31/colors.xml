<?xml version="1.0" encoding="utf-8"?>
<!-- Material You overrides (API 31+). Only the ACCENT is dynamic: the card
     stays AMOLED black and text stays light in light mode too, so nothing else
     is overridden here and no night variant is needed. -->
<resources>
    <!-- Wallpaper-tinted accent — light tints, because they sit on black. -->
    <color name="widget_accent">@android:color/system_accent1_200</color>
    <color name="widget_on_accent">@android:color/system_accent1_900</color>
</resources>
