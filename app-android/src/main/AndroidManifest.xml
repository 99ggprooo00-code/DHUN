<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the app show the system dialog to leave the battery-optimizer
         blacklist — without it MIUI/OneUI/HyperOS kill background playback. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ADR-006: persistent offline downloads. The download service runs as
         a dataSync foreground service so downloads survive the app being
         backgrounded or killed by OEM battery savers. WAKE_LOCK is already
         declared above and is required for the FGS to keep the CPU alive
         while a download is in flight on API 31+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".DhunApp"
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.DhunPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- ADR-006: download foreground service. dataSync is the right
             semantic type for user-initiated file downloads (the Android 14
             replacement for the old "download" type) and avoids Play-Store
             review issues. The service hosts the existing shared
             DownloadManager — it does NOT re-implement the engine. -->
        <service
            android:name=".download.DhunDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Candidate 26: home-screen widget — Quick Play, the only widget
             DHUN ships. It feeds the existing playback service state via
             MediaController (read-only) and gracefully shows "Nothing
             playing" when idle.

             Now Playing (the former 4×2 companion) was deleted on device
             feedback: its 140dp minimum height exceeded a 4×2 slot (~110dp),
             and strict launchers refuse to add a widget that does not fit
             rather than growing it a row. Its provider name, layout ids and
             picker metadata are all gone; do NOT reintroduce a second
             receiver without re-checking slot sizing.

             The Quick Play provider name, its layouts, view ids and
             @xml/widget_quick_play_info are load-bearing: an instance already
             sitting on a home screen keeps working across an app update only
             while every one of those identifiers is unchanged. -->
        <receiver
            android:name=".widgets.DhunQuickPlayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_play_info" />
        </receiver>
    </application>
</manifest>
