# Editor defaults for this repository.
#
# The web workstream is plain text all the way down — ES modules, CSS, Markdown,
# Python — and the only thing an editor can get wrong that CI will not catch is
# whitespace. CI *does* catch line endings in some files (the Kotlin sources are
# LF), but the cheapest place to fix it is here.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two spaces at the end of a line is a hard line break in Markdown, and the
# phase documents use it deliberately. An editor that strips it silently
# reflows the document.
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
