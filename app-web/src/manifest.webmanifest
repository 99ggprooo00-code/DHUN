{
  "name": "DHUN — music player",
  "short_name": "DHUN",
  "description": "A free, open-source music player. Search YouTube Music anonymously in the browser; your library stays on your device, and the app says when a source will not answer.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#161616",
  "theme_color": "#161616",
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search the catalogue",
      "url": "./#/search"
    },
    {
      "name": "Your library",
      "short_name": "Library",
      "description": "Playlists, liked songs and history",
      "url": "./#/library/playlists"
    }
  ]
}
